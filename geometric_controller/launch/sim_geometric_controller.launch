 <launch>
  <arg name="mav_name" default="iris"/>

  <!-- choose controller -->
  <!-- command_input = 2 leads to geometric_attcontroller
       command_input = 1 leads to attcontroller.
  -->
       
  <arg name="command_input" default="attitude_control" />

  <!-- manually arm and offboard drone -->
  <arg name="gazebo_simulation" default="true" />


  <node pkg="geometric_controller" type="geometric_controller_node" name="geometric_controller" output="screen">
            <param name="mav_name" type="string" value="$(arg mav_name)" />
            <remap from="command/bodyrate_command" to="/mavros/setpoint_raw/attitude"/>
            <!-- simulation or not -->
            <param name="enable_sim" value="$(arg gazebo_simulation)" />
            <!-- set gps -->
            <param name="use_gps" value="false" />
            <!-- set vicon -->
            <param name="use_vicon" value="true" />
            <param name="vicon_topic" value="/vicon/drone" />
            <!-- set control mode -->
            <param name="ctrl_mode" value="$(arg command_input)" />
            <param name="mission_time" value ="100" />
            <param name="max_acc" value="10.0" />
            <!--Params specific for Iris copter-->
            <param name="attctrl_constant" value="0.3"/>
            <param name="normalizedthrust_constant" value="0.06"/> <!-- 0.06 -->
            <param name="normalizedthrust_offset" value="0.1"/>
            <param name="Kp_x" value="10.0" />
            <param name="Kp_y" value="10.0" />
            <param name="Kp_z" value="20.0" />
            <param name="Kv_x" value="5.0"/>
            <param name="Kv_y" value="5.0"/>
            <param name="Kv_z" value="10.0"/>           
    </node>


  <node pkg="trajectory_generator" type="trajectory_generator_node" name="trajectory_generator_node" output="screen">
              <param name="config_file" value="$(find trajectory_generator)/config/sim_circle2circle.yaml"/>
   </node>   
  </launch>