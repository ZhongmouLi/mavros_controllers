 <launch>
 
 <arg name = "bags_directory" value = "$(find geometric_controller)/Log_Bag/"/>
 
 <node pkg="rosbag" type="record" name="rosbag_record_cam"
       args="record -o $(arg bags_directory) /vicon/drone1 /mavros/vision_pose/pose /mavros/local_position/pose /mavros/state /mavros/setpoint_raw/attitude reference/setpoint reference/yaw" />

   

</launch>



